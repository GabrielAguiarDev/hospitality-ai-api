# Banco interno da IA (leitura e escrita; migrations: pnpm migration:run)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=yago_ai_local
DB_USER=yago_dev
DB_PASSWORD=

# Snapshot original do resort — usuário somente SELECT, nunca gravar
RESORT_DB_HOST=127.0.0.1
RESORT_DB_PORT=3308
RESORT_DB_NAME=resort_snapshot
RESORT_DB_USER=resort_reader
RESORT_DB_PASSWORD=

# Resort atendido por esta instância e seu fuso horário
RESORT_ID=demo
RESORT_TIMEZONE=America/Bahia

# Ollama / modelos locais
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:1.7b
OLLAMA_EMBED_MODEL=embeddinggemma:300m-qat-q4_0
# Limites de geração (padrões: 512 tokens de saída, contexto de 8192)
OLLAMA_NUM_PREDICT=512
OLLAMA_NUM_CTX=8192

# RAG
CHROMA_URL=http://127.0.0.1:8000
RAG_MAX_DISTANCE=0.50
RAG_TOP_K=4
KNOWLEDGE_SYNC_ENABLED=true
# Fontes indexadas e pesquisadas: resort-snapshot (dados reais) e,
# opcionalmente, mysql-resort-knowledge (conhecimento fictício legado)
KNOWLEDGE_SOURCES=resort-snapshot

# Modo de demonstração — somente desenvolvimento local
NODE_ENV=development
ENABLE_DEMO_GUEST_CONTEXT=true
# true: aceita qualquer titular com hospedagem ativa; false: só DEMO_ALLOWED_GUEST_IDS
DEMO_DYNAMIC_GUEST_ENABLED=true
DEMO_ALLOWED_GUEST_IDS=
DEMO_ALLOWED_CLIENT_IPS=127.0.0.1,::1
DEMO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],10.0.2.2
# Opcional: exige o header X-Demo-Secret com este valor
DEMO_SHARED_SECRET=
# A exigência de hospedagem ativa só pode ser desligada com dados sintéticos
DEMO_REQUIRE_ACTIVE_STAY=true
DEMO_DATASET=

# Reservas simuladas de experiências
BOOKING_PREVIEW_TTL_MINUTES=15

MYSQL_ROOT_PASSWORD=
RESORT_MYSQL_ROOT_PASSWORD=
