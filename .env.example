# Banco interno da IA (leitura e escrita; migrations: pnpm migration:run)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=yago_ai_local
DB_USER=yago_dev
DB_PASSWORD=

# Snapshot original do resort — usuário somente SELECT, nunca gravar
RESORT_DB_HOST=127.0.0.1
RESORT_DB_PORT=3308
RESORT_DB_NAME=resort_snapshot
RESORT_DB_USER=resort_reader
RESORT_DB_PASSWORD=

# Resort atendido por esta instância e seu fuso horário
RESORT_ID=demo
RESORT_TIMEZONE=America/Bahia

# Ollama / modelos locais (configuração única: src/llm/llm-config.ts)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Respostas do RAG. Testados: qwen3.5:2b-q4_K_M (mais rápido),
# qwen3.5:4b (mais preciso) e qwen3:1.7b (modelo anterior).
# Saudações e agradecimentos não usam o modelo.
OLLAMA_CHAT_MODEL=qwen3.5:2b-q4_K_M
# Classificação estruturada e function calling. Vazio = mesmo modelo das
# respostas (recomendado: um só modelo carregado na memória).
OLLAMA_CLASSIFIER_MODEL=
# Embeddings do RAG (não muda com o modelo de chat)
OLLAMA_EMBED_MODEL=embeddinggemma:300m-qat-q4_0
# Limites de geração (padrões: 320 tokens de saída, contexto de 8192).
# O mesmo num_ctx vale para todas as chamadas: valores diferentes
# fariam o Ollama recarregar o modelo a cada troca (1 a 5 s).
OLLAMA_NUM_PREDICT=320
OLLAMA_NUM_CTX=8192
# Raciocínio explícito dos modelos qwen (padrão: false, respostas diretas)
OLLAMA_THINK=false
# Tempo que os modelos ficam carregados após a última chamada
OLLAMA_KEEP_ALIVE=30m
OLLAMA_EMBED_KEEP_ALIVE=10m
# Carrega os modelos na inicialização da API (padrão: true)
OLLAMA_WARMUP=true
# Comparação entre modelos: pnpm models:evaluate
OLLAMA_EVAL_MODELS=qwen3.5:2b-q4_K_M,qwen3.5:4b,qwen3:1.7b
# Nomes antigos ainda aceitos: OLLAMA_URL e OLLAMA_MODEL

# RAG
CHROMA_URL=http://127.0.0.1:8000
RAG_MAX_DISTANCE=0.50
RAG_TOP_K=4
KNOWLEDGE_SYNC_ENABLED=true
# Fontes indexadas e pesquisadas: resort-snapshot (dados reais) e,
# opcionalmente, mysql-resort-knowledge (conhecimento fictício legado)
KNOWLEDGE_SOURCES=resort-snapshot

# Modo de demonstração — somente desenvolvimento local
NODE_ENV=development
ENABLE_DEMO_GUEST_CONTEXT=true
# true: aceita qualquer titular com hospedagem ativa; false: só DEMO_ALLOWED_GUEST_IDS
DEMO_DYNAMIC_GUEST_ENABLED=true
DEMO_ALLOWED_GUEST_IDS=
DEMO_ALLOWED_CLIENT_IPS=127.0.0.1,::1
DEMO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],10.0.2.2
# Opcional: exige o header X-Demo-Secret com este valor
DEMO_SHARED_SECRET=
# A exigência de hospedagem ativa só pode ser desligada com dados sintéticos
DEMO_REQUIRE_ACTIVE_STAY=true
DEMO_DATASET=

# Reservas simuladas de experiências
BOOKING_PREVIEW_TTL_MINUTES=15

MYSQL_ROOT_PASSWORD=
RESORT_MYSQL_ROOT_PASSWORD=
